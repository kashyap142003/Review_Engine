      ]
    },
    "Wait 1 Hour": {
      "main": [ [ { "node": "Send Google Review Invite via Gmail", "type": "main", "index": 0 } ] ]
    },
    "Send Google Review Invite via Gmail": {
      "main": [ [ { "node": "Update Track (Invite Sent)", "type": "main", "index": 0 } ] ]
    },
    "Log Row in Issues Sheet": {
      "main": [ [ { "node": "Send Urgent Alert to Owner via Gmail", "type": "main", "index": 0 } ] ]
    },
    "Send Urgent Alert to Owner via Gmail": {
      "main": [ [ { "node": "Auto-Reply Customer via Gmail", "type": "main", "index": 0 } ] ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
