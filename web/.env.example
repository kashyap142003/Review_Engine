# Copy to web/.env.local and fill in. NEVER commit real values.
# Leave VITE_SUPABASE_URL / VITE_SUPABASE_PUBLISHABLE_KEY empty (or set VITE_USE_MOCK=1)
# to run the dashboard on mock data without any backend.

# Supabase project (browser-safe, publishable key only)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<your-anon-key>

# Base URL of the deployed Supabase Edge Functions (e.g. https://<ref>.functions.supabase.co)
VITE_SUPABASE_FUNCTIONS_URL=https://<project-ref>.functions.supabase.co

# Force mock/demo mode even when Supabase is configured
VITE_USE_MOCK=0

# White-label product identity (optional, from client configuration)
VITE_PRODUCT_NAME=Review Engine
VITE_PRODUCT_LOGO_URL=
VITE_PRODUCT_ACCENT=#4F46E5